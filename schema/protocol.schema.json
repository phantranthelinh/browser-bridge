    },
    "NavigateArgs": {
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "http(s) URL or about:blank"
        },
        "newTab": {
          "type": "boolean",
          "description": "Open a new background tab instead of reusing the current tab"
        },
        "groupTitle": {
          "type": "string",
          "description": "Tab group title, used only when the group is created. Defaults to the session name"
        }
