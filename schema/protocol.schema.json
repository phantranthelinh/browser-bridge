        "value": {
          "type": "string",
          "description": "Option value. Give exactly one of value or label"
        },
        "label": {
          "type": "string",
          "description": "Visible option text. Give exactly one of value or label"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "selector"
      ],
      "title": "SelectArgs"
    },
    "SelectResult": {
      "properties": {
