        "data": true
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "name"
      ],
      "title": "EventFrame"
    },
    "FillArgs": {
      "properties": {
        "selector": {
          "type": "string",
          "minLength": 1,
          "description": "Element ref from snapshot (@e12) or a CSS selector that matches exactly one element"
        },
        "value": {
          "type": "string",
          "description": "Text to put in the field. Empty string clears it"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "selector",
        "value"
      ],
