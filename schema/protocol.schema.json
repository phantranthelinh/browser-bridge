          "type": "string"
        },
        "extensionId": {
          "type": "string"
        },
        "browser": {
          "type": "string",
          "enum": [
            "chrome",
            "edge"
          ]
        },
        "actions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "protocolVersion",
        "extensionVersion",
        "extensionId",
        "browser",
        "actions"
      ],
      "title": "Hello"
    },
    "ListTabsResult": {
      "properties": {
        "tabs": {
          "items": {
            "properties": {
              "tabId": {
                "type": "integer"
              },
              "url": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "current": {
                "type": "boolean"
              },
              "borrowed": {
                "type": "boolean"
              }
