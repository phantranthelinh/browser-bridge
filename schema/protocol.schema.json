        "files"
      ],
      "title": "UploadArgs"
    },
    "UploadResult": {
      "properties": {
        "fileCount": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "fileCount"
      ],
      "title": "UploadResult"
    },
    "WaitForArgs": {
      "oneOf": [
        {
          "required": [
            "selector"
          ],
          "title": "selector"
        },
        {
          "required": [
            "text"
          ],
          "title": "text"
        },
        {
          "required": [
            "urlContains"
          ],
          "title": "urlContains"
        },
        {
          "required": [
            "load"
          ],
          "title": "load"
        }
      ],
      "properties": {
        "selector": {
          "type": "string",
          "description": "Wait for this element to reach state"
        },
        "state": {
          "type": "string",
          "enum": [
            "visible",
            "hidden"
          ],
          "description": "Only together with selector",
          "default": "visible"
        },
        "text": {
          "type": "string",
          "description": "Wait until the page text contains this"
        },
        "urlContains": {
          "type": "string"
        },
        "load": {
          "type": "boolean",
          "const": true,
          "description": "Wait for the load event. Must be true"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "dependentRequired": {
        "state": [
          "selector"
        ]
      },
      "title": "WaitForArgs"
    },
    "WaitForResult": {
      "properties": {
        "matched": {
          "type": "boolean"
        },
        "elapsedMs": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "matched",
        "elapsedMs"
      ],
      "title": "WaitForResult"
    },
    "Welcome": {
      "properties": {
        "type": {
          "type": "string",
          "enum": [
