      "type": "string",
      "enum": [
        "navigate",
        "find_tab",
        "activate_tab",
        "list_tabs",
        "close_tab",
        "close_session",
        "go_back",
        "go_forward",
        "reload",
        "snapshot",
        "click",
        "fill",
        "select",
        "press_key",
        "scroll",
        "upload",
        "wait_for",
        "screenshot",
        "network_start",
        "network_requests",
        "network_request_detail",
        "network_stop",
        "handle_dialog",
        "evaluate",
        "cdp"
      ],
      "title": "ActionName"
    },
    "CDPArgs": {
      "properties": {
        "method": {
          "type": "string",
