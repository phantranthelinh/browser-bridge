      "additionalProperties": false,
      "type": "object",
      "required": [
        "mode"
      ],
      "title": "FillResult"
    },
    "FindTabArgs": {
      "properties": {
        "url": {
          "type": "string",
          "description": "Host to match: example.com also matches www.example.com. Path is ignored"
        },
        "active": {
          "type": "boolean",
          "description": "Borrow the tab the user is looking at instead of searching the session's tabs"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "title": "FindTabArgs"
    },
    "FindTabResult": {
      "properties": {
        "tabId": {
          "type": "integer"
        },
        "url": {
          "type": "string"
