          "const": 2
        },
        "daemonVersion": {
          "type": "string"
        },
        "blockedHosts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "protocolVersion",
        "daemonVersion",
        "blockedHosts"
      ],
      "title": "Welcome"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrowserBridgeProtocol"
}
