      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "title": "EvaluateResult"
    },
    "EventFrame": {
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "event"
          ]
