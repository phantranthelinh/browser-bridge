        "session": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "args": true,
        "deadline": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "id",
        "session",
        "action",
        "args",
        "deadline"
      ],
      "title": "RequestFrame"
    },
    "ResponseFrame": {
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "response"
          ]
        },
        "id": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "data": true,
        "error": {
          "properties": {
            "code": {
              "type": "string",
